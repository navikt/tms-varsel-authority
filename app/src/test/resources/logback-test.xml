<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="test/team-logs-for-test.xml"/>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="auditLogger" class="no.nav.tms.varsel.authority.read.TestAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <pattern>%m%n%xEx</pattern>
        </layout>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="auditLog" level="INFO" additivity="false">
        <appender-ref ref="auditLogger"/>
    </logger>
</configuration>
